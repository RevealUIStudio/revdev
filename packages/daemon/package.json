{
  "name": "@revdev/daemon",
  "version": "0.1.0",
  "description": "Harness daemon — AI agent coordination, PTY management, and inter-agent messaging",
  "repository": {
    "type": "git",
    "url": "https://github.com/RevealUIStudio/revdev.git",
    "directory": "packages/daemon"
  },
  "license": "FSL-1.1-MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "revdev-daemon": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/agent-identity-crypto.d.ts",
      "import": "./dist/agent-identity-crypto.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    }
  },
  "files": [
    "dist",
    "systemd",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --declarationDir dist --noEmit false",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "start:detached": "node dist/cli.js --detach",
    "setup:systemd": "bash systemd/install.sh",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --testPathPattern=e2e",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@neondatabase/serverless": "^1.1.0",
    "@revdev/protocol": "workspace:*",
    "@revealui/contracts": "^1.4.0",
    "@revealui/core": "^0.10.1",
    "@revealui/utils": "^0.3.5",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "funding": {
    "type": "commercial",
    "url": "https://revealui.com/pro"
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  }
}
