{
  "name": "@revdev/daemon",
  "version": "0.1.0",
  "description": "Harness daemon — AI agent coordination, PTY management, and inter-agent messaging",
  "repository": {
    "type": "git",
    "url": "https://github.com/RevealUIStudio/revdev.git",
    "directory": "packages/daemon"
  },
  "license": "FSL-1.1-MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "revdev-daemon": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --testPathPattern=e2e",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@revdev/protocol": "workspace:*",
    "@revealui/core": "0.6.0",
    "@revealui/utils": "0.3.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "funding": {
    "type": "commercial",
    "url": "https://revealui.com/pro"
  },
  "private": true,
  "publishConfig": {
    "access": "restricted"
  }
}
