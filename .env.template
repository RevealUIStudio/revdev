# RevDev Environment Configuration
# Copy to .env and fill in values

# ---------- RevealUI API ----------
# URL of the RevealUI API instance this RevDev installation connects to
REVEALUI_API_URL=http://localhost:3004

# ---------- License ----------
# Pro/Max/Enterprise license key (format: RVUI-<tier>-<32-hex-chars>)
# Required for agent spawning, inference management, and merge pipeline
# Session management works without a license (free tier)
# REVEALUI_LICENSE_KEY=

# ---------- Daemon ----------
# Unix socket path (default: ~/.local/share/revealui/harness.sock)
# DAEMON_SOCKET_PATH=
# Data directory for PGlite database (default: ~/.local/share/revealui)
# DAEMON_DATA_DIR=
# HTTP gateway port (0 = disabled, set to enable remote access)
# DAEMON_HTTP_PORT=0
# HTTP gateway bind address
# DAEMON_HTTP_HOST=127.0.0.1
# License cache TTL in milliseconds (default: 15000)
# LICENSE_CACHE_TTL_MS=15000

# ---------- Studio (Tauri) ----------
# Daemon connection URL for remote mode (leave empty for local socket)
# REVDEV_DAEMON_URL=

# ---------- Inference ----------
# Ollama API URL (if using local inference)
# OLLAMA_URL=http://localhost:11434
# Snap inference model path
# SNAP_MODEL_PATH=

# ---------- OpenRouter (optional; off unless provider is openrouter) ----------
# Read at call time. Never commit a real key. Leave blank to keep the local path.
# OPENROUTER_API_KEY=
# Default model. Must be on the US allowlist. Default: google/gemma-4-31b-it:free
# REVDEV_OPENROUTER_MODEL=
# 1 = data_collection allow, plus training-tier and explicit allowlist ids.
# REVDEV_OPENROUTER_ALLOW_TRAINING=0
# 1 = permit an explicit model of openrouter/free. Violates the US-only lock.
# REVDEV_OPENROUTER_ALLOW_FREE_ROUTER=0
# HTTP-Referer sent with each request.
# REVDEV_OPENROUTER_REFERER=https://revealui.com
# X-OpenRouter-Title and X-Title.
# REVDEV_OPENROUTER_TITLE=RevDev
# 1 = omit the hidden app-visibility header.
# REVDEV_OPENROUTER_PUBLIC_APP=0
# Per-call timeout in milliseconds.
# REVDEV_OPENROUTER_CHAT_TIMEOUT_MS=120000

# ---------- Git ----------
# Default base branch for merge pipeline
# GIT_BASE_BRANCH=test
